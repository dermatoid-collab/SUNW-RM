<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark: the app pages match the widget. -->
    <style name="Theme.SunW" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FFB547</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:windowAnimationStyle">@style/PageTransitions</item>
    </style>

    <!-- One movement for every page change ("shared axis" X): forward slides left, back
         slides right, both with a short fade. The day page uses the same motion between days. -->
    <style name="PageTransitions" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/page_close_exit</item>
    </style>

    <style name="SectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SubHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:alpha">0.75</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
