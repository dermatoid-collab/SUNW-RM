<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/curve"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/curve_description"
        android:scaleType="fitCenter"
        android:src="@drawable/curve_placeholder" />

    <include layout="@layout/widget_sun_row" />

    <!-- Live countdowns, shown only on the app's main page (the home widget can't tick every second). -->
    <LinearLayout
        android:id="@+id/countdown_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/sunrise_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:gravity="start"
            android:paddingStart="20dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sunset_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:paddingEnd="20dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
