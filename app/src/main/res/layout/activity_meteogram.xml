<?xml version="1.0" encoding="utf-8"?>
<!-- Opened from today's rainspot on the main page: Windy radar / rain map and the 7-day meteogram. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/mg_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sm_back"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mg_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:maxLines="1"
                    android:text="@string/mg_open"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/mg_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Windy map: radar (recent hours) or rain forecast, with its own timeline and play. -->
        <LinearLayout
            android:id="@+id/mg_radar_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/mg_layers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mg_layer_radar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/mg_layer_radar"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/mg_layer_rain"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/mg_layer_rain"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="440dp">

                <WebView
                    android:id="@+id/mg_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/mg_map_error"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/mg_map_offline"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Webcams near the place: four previews and the button to the full list. -->
        <LinearLayout
            android:id="@+id/mg_webcams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/mg_webcams_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wc_title"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/mg_webcams_mine_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/wc_section_mine"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/mg_webcams_mine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/mg_webcams_near_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/wc_section_near"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/mg_webcams_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/mg_webcams_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/mg_webcams_all"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/wc_all"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- The last 24 hours, every 15 minutes. -->
        <LinearLayout
            android:id="@+id/mg_last24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mg_last24_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/l24_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/mg_last24_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp" />
            </LinearLayout>

            <it.sunw.widget.weather.Last24hView
                android:id="@+id/mg_last24_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/mg_last24_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/l24_legend"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- The pressure of the last 24 hours, every hour, under the temperature's. -->
        <LinearLayout
            android:id="@+id/mg_pressure24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mg_pressure24_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/p24_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/mg_pressure24_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp" />
            </LinearLayout>

            <it.sunw.widget.weather.Last24hView
                android:id="@+id/mg_pressure24_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/mg_pressure24_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/p24_legend"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mg_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:paddingVertical="14dp">

            <HorizontalScrollView
                android:id="@+id/mg_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <it.sunw.widget.weather.MeteogramView
                    android:id="@+id/mg_chart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/mg_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="14dp"
                android:text="@string/mg_legend"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/mg_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:paddingHorizontal="22dp"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
