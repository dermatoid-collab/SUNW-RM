<?xml version="1.0" encoding="utf-8"?>
<!-- Sun and Moon on any date within ±6 months: opened from the sun or moon tile. The date bar
     stays at the top and the slider at the bottom; everything between them scrolls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

        <!-- Same look as the main page: place on the left, short date on the right (tap it to
             pick another date). -->
        <LinearLayout
            android:id="@+id/sm_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/sm_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sm_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/sm_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textSize="28sp"
                android:translationY="-4dp" />

            <TextView
                android:id="@+id/sm_date"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:textSize="17sp"
                android:translationY="-3dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/sm_page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="14dp">

        <!-- Everything that changes with the date; slides sideways like the weather days. -->
        <LinearLayout
            android:id="@+id/sm_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sm_section_sun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="section"
                    android:text="@string/sm_section_sun"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:tag="rule" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sm_sun_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="0dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <it.sunw.widget.SunPathView
                    android:id="@+id/sm_curve"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:contentDescription="@string/curve_description" />

                <TextView
                    android:id="@+id/sm_cursor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sm_sunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_sunrise"
                            android:drawablePadding="4dp"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/sm_rise_az"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:paddingStart="20dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sm_length"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/sm_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sm_sunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_sunset"
                            android:drawablePadding="4dp"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/sm_set_az"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:paddingEnd="20dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sm_useful_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/sm_useful_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sm_useful"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/sm_useful"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Twilight table: one row per twilight, plus noon. Filled in code. -->
                    <LinearLayout
                        android:id="@+id/sm_twilights"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical" />

                    <it.sunw.widget.SunCompassView
                        android:id="@+id/sm_compass"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sm_morning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/sm_evening"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sm_compare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:tag="cell">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:text="@string/sm_kpi_day"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sm_kpi_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:tag="value"
                    android:textSize="22sp" />
                <TextView
                    android:id="@+id/sm_kpi_day_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:tag="cell">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:text="@string/sm_kpi_sun_max"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sm_kpi_sun_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:tag="value"
                    android:textSize="22sp" />
                <TextView
                    android:id="@+id/sm_kpi_sun_max_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:tag="card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sm_day_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:tag="value"
                        android:text="@string/sm_chart_day"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/sm_day_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="label"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sm_day_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="label"
                    android:textSize="11sp" />

                <it.sunw.widget.YearChartView
                    android:id="@+id/sm_year"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@string/sm_year_description" />

                <TextView
                    android:id="@+id/sm_next_event"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="value"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sm_section_times"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="section"
                    android:text="@string/sm_section_times"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:tag="rule" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:tag="card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sm_times_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:tag="value"
                        android:text="@string/sm_chart_times"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/sm_times_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="label"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sm_times_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="label"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/sm_rise_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp" />

                <it.sunw.widget.YearChartView
                    android:id="@+id/sm_rise_chart"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/sm_chart_times" />

                <TextView
                    android:id="@+id/sm_set_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp" />

                <it.sunw.widget.YearChartView
                    android:id="@+id/sm_set_chart"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/sm_chart_times" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sm_section_moon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="section"
                    android:text="@string/sm_section_moon"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:tag="rule" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sm_moon_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/card_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/sm_moon_image"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="18dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/sm_moon_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:textSize="34sp" />

                        <TextView
                            android:id="@+id/sm_moon_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sm_moon_times"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/sm_moon_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:tag="cell">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:text="@string/sm_kpi_night"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sm_kpi_night"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:tag="value"
                    android:textSize="19sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:text="@string/sm_kpi_night_sub"
                    android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:tag="cell">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:text="@string/sm_kpi_moon_sky"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sm_kpi_moon_sky"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:tag="value"
                    android:textSize="19sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:text="@string/sm_kpi_moon_sky_sub"
                    android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:tag="cell">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:text="@string/sm_kpi_moon_max"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sm_kpi_moon_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:tag="value"
                    android:textSize="19sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="label"
                    android:text="@string/sm_kpi_moon_max_sub"
                    android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:tag="card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sm_chip_night"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/sm_chip_night"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/sm_chip_sky"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/sm_chip_sky"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sm_moon_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:tag="value"
                        android:text="@string/sm_chart_night"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/sm_moon_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="label"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sm_moon_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="label"
                    android:textSize="11sp" />

                <it.sunw.widget.YearChartView
                    android:id="@+id/sm_moon_chart"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@string/sm_chart_moon" />

                <TextView
                    android:id="@+id/sm_moon_chart_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:tag="value"
                    android:textSize="12.5sp" />
            </LinearLayout>

        </LinearLayout>
        </LinearLayout>
        </ScrollView>

        <!-- Fixed at the bottom: the day tabs, then the slider with the range ends and Today. -->
        <LinearLayout
            android:id="@+id/sm_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/sm_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:orientation="horizontal" />

        <SeekBar
            android:id="@+id/sm_slider"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@string/sm_slider_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sm_min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/sm_today"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/sm_today"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sm_max"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="11sp" />
        </LinearLayout>
        </LinearLayout>
</LinearLayout>
