<?xml version="1.0" encoding="utf-8"?>
<!-- Sun and Moon on any date within ±6 months: opened from the sun or moon tile. The date bar
     stays at the top and the slider at the bottom; everything between them scrolls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sm_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/sm_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sm_back"
                android:src="@drawable/ic_arrow_back" />

            <!-- Tap the date to pick another one. -->
            <LinearLayout
                android:id="@+id/sm_date"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/sm_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/sm_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/sm_page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

        <!-- Everything that changes with the date; slides sideways like the weather days. -->
        <LinearLayout
            android:id="@+id/sm_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/sm_sun_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <it.sunw.widget.SunPathView
                    android:id="@+id/sm_curve"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:contentDescription="@string/curve_description" />

                <TextView
                    android:id="@+id/sm_cursor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sm_sunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_sunrise"
                            android:drawablePadding="4dp"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/sm_rise_az"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:paddingStart="20dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sm_length"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/sm_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/sm_sunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_sunset"
                            android:drawablePadding="4dp"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/sm_set_az"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:paddingEnd="20dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sm_useful_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/sm_useful_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sm_useful"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/sm_useful"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Twilight table: one row per twilight, plus noon. Filled in code. -->
                    <LinearLayout
                        android:id="@+id/sm_twilights"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical" />

                    <it.sunw.widget.SunCompassView
                        android:id="@+id/sm_compass"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sm_morning"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/sm_evening"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sm_compare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sm_moon_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/sm_moon_image"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="18dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/sm_moon_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:includeFontPadding="false"
                            android:textSize="34sp" />

                        <TextView
                            android:id="@+id/sm_moon_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sm_moon_times"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/sm_moon_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <it.sunw.widget.YearStripView
            android:id="@+id/sm_year"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/sm_year_description" />

        <TextView
            android:id="@+id/sm_next_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:layout_marginTop="4dp"
            android:textSize="12.5sp" />

        <LinearLayout
            android:id="@+id/sm_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        </LinearLayout>
        </ScrollView>

        <!-- Fixed at the bottom: the slider, with the range ends and Today. -->
        <LinearLayout
            android:id="@+id/sm_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

        <SeekBar
            android:id="@+id/sm_slider"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@string/sm_slider_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sm_min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/sm_today"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/sm_today"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sm_max"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="11sp" />
        </LinearLayout>
        </LinearLayout>
</LinearLayout>
