<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1. Weights must match TINY_CURVE_FRACTION in WidgetRenderer (curve 0.26, rows 0.37 each). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_tiny"
    android:orientation="vertical"
    android:paddingHorizontal="5dp"
    android:paddingVertical="5dp">

    <ImageView
        android:id="@+id/curve"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.26"
        android:contentDescription="@string/curve_description"
        android:scaleType="fitCenter"
        android:src="@drawable/curve_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.37"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/sunrise_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sunrise" />

        <!-- Autosize: the text grows to fill the row, whatever the widget size. -->
        <TextView
            android:id="@+id/sunrise"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="48sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="07:17"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sunset_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.37"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sunset" />

        <TextView
            android:id="@+id/sunset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="48sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="18:57"
            android:textColor="@color/widget_text" />
    </LinearLayout>
</LinearLayout>
